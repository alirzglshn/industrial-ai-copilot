# Copy to .env and adjust as needed.

APP_NAME=industrial-ai-copilot
ENVIRONMENT=development

# Postgres (metadata: documents, pages, chunks, images)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://copilot:copilot@postgres:5432/copilot

# Qdrant (vector store: text + image embeddings)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_TEXT=manual_text_chunks
QDRANT_COLLECTION_IMAGES=manual_images

# Models (swappable; see ARCHITECTURE.md "Chosen local models".
# Defaults below are sized for CPU-only inference (no dedicated GPU).)
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
VLM_MODEL=vikhyatk/moondream2
