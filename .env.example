# Copy to .env and adjust as needed.

APP_NAME=industrial-ai-copilot
ENVIRONMENT=development

# Postgres (metadata: documents, pages, chunks, images)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://copilot:copilot@postgres:5432/copilot

# Qdrant (vector store: text + image embeddings)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_TEXT=manual_text_chunks
QDRANT_COLLECTION_IMAGES=manual_images

# Answer generation. The default is a small text model: a VLM large enough to
# read a schematic takes minutes per answer on CPU. Set USE_VLM_FOR_ANSWERS=true
# to put the retrieved images themselves in front of the model instead.
#
# Qwen2.5-0.5B-Instruct is smaller and faster but, measured against real
# manuals, would not reliably emit citations or refuse off-topic questions —
# see ARCHITECTURE.md "Model choice". 1.5B is the tested default.
# Point this at a local directory (e.g. models/Qwen2.5-1.5B-Instruct) to skip
# the Hugging Face download entirely once you have the weights on disk.
ANSWER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
USE_VLM_FOR_ANSWERS=false
ANSWER_MAX_NEW_TOKENS=300
ANSWER_MAX_IMAGES=3
ANSWER_TOP_K=5

# Agent (Phase 6). Single-shot planning, not iterative ReAct: every extra
# planning turn is tens of seconds on CPU, so raising this trades latency for
# a longer tool sequence rather than better reliability.
AGENT_MAX_STEPS=4
AGENT_PLANNER_MAX_NEW_TOKENS=220

# Models (swappable; see ARCHITECTURE.md "Chosen local models".
# Defaults below are sized for CPU-only inference (no dedicated GPU).)
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
VLM_MODEL=vikhyatk/moondream2

# Ingestion
UPLOAD_DIR=data/uploads
IMAGE_DIR=data/images
MAX_UPLOAD_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval. Set AUTO_INDEX_ON_UPLOAD=false to ingest without embedding, then
# index explicitly via POST /documents/{id}/index.
AUTO_INDEX_ON_UPLOAD=true
SEARCH_TOP_K=5
EMBED_BATCH_SIZE=64

# Multimodal retrieval. Text and image scores are not comparable, so results
# are merged by rank; RRF_K is the Reciprocal Rank Fusion constant.
INCLUDE_IMAGES_IN_SEARCH=true
IMAGE_SEARCH_TOP_K=5
PAGE_CONTEXT_IMAGES=true
RRF_K=60

# Captioning is expensive on CPU (seconds per image) and off by default.
# Turning it on describes every extracted image with a vision-language model
# and folds the caption into the image's vector.
ENABLE_IMAGE_CAPTIONING=false
CAPTION_MODEL=Salesforce/blip-image-captioning-base
CAPTION_MAX_NEW_TOKENS=40
# Leave empty for a plain captioner like BLIP; instruction-following VLMs
# need a prompt, e.g. "Describe this technical diagram."
CAPTION_PROMPT=
